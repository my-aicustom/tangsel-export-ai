---
import '../styles/global.css';
import { Sidebar } from '../components/Sidebar';
import { Header } from '../components/Header';
import { VEYLO_BASE_URL } from '../lib/veyloBridge';

interface Props {
  title: string;
  subtitle: string;
  currentPath: string;
}

const { title, subtitle, currentPath } = Astro.props;
const description = `${subtitle} — Tangsel Export AI, Dinas Perindustrian dan Perdagangan Kota Tangerang Selatan.`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#047857" />
    <meta name="color-scheme" content="light" />
    <title>{title} — Tangsel Export AI</title>
    <link rel="icon" type="image/png" href="/branding/logo-tangsel.png?v=3" />
    <link rel="shortcut icon" type="image/png" href="/branding/logo-tangsel.png?v=3" />
    <link rel="apple-touch-icon" href="/branding/logo-tangsel.png?v=3" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-slate-50 font-sans text-slate-900 antialiased selection:bg-emerald-700 selection:text-white">
    <div class="flex min-h-screen flex-col bg-slate-50 lg:flex-row">
      <Sidebar client:load currentPath={currentPath} />

      <div class="dashboard-main flex min-w-0 flex-1 flex-col overflow-x-hidden">
        <Header client:load title={title} subtitle={subtitle} />

        <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-5 sm:px-6 sm:py-6 lg:px-8 lg:py-8">
          <slot />
        </main>

        <footer class="mt-auto border-t border-slate-200 bg-white px-4 py-5 text-xs text-slate-500 sm:px-6 lg:px-8">
          <div class="mx-auto flex max-w-7xl flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <span>© 2026 Dinas Perindustrian dan Perdagangan Kota Tangerang Selatan</span>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span>Trade Expo Indonesia 2026</span>
              <a href={VEYLO_BASE_URL} target="_blank" rel="noreferrer" class="font-semibold text-emerald-800 hover:underline">
                Ruang Negosiasi ↗
              </a>
            </div>
          </div>
        </footer>
      </div>
    </div>
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
